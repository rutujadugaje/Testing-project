# ---------------------------------------------------------------------------
# Finora AI configuration
#
# Finora runs fully offline without these. When no API key is present the app
# uses a built-in deterministic agent that exercises the same tool contracts,
# so every feature stays clickable — it just doesn't call a real model.
#
# Copy to `.env.local` (git-ignored) and fill in to enable the real model.
# ---------------------------------------------------------------------------

# Any OpenAI-compatible key: OpenAI, OpenRouter, Groq, a gateway, or a proxy.
VITE_AI_API_KEY=

# Override for OpenAI-compatible providers. Leave blank for OpenAI itself.
#   OpenRouter -> https://openrouter.ai/api/v1
#   Groq       -> https://api.groq.com/openai/v1
#   Ollama     -> http://localhost:11434/v1
VITE_AI_BASE_URL=

# Model id passed to the provider.
VITE_AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# SECURITY: any VITE_-prefixed variable is inlined into the client bundle and
# is therefore visible to anyone who opens devtools. That is acceptable for
# local/self-hosted use with a scoped key.
#
# For a real deployment, do NOT ship a key. Put a server route in front of the
# model and point the app at it:
#   VITE_AI_BASE_URL=https://your-app.com/api/ai
# and have that route inject the secret server-side. See README → Security.
# ---------------------------------------------------------------------------
